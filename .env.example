# ToolHub 环境变量示例
#
# 用法：复制为仓库根目录的 .env（与 backend/、frontend/ 同级），按需改值。
#     cp .env.example .env
# .env 已被 .gitignore 忽略，绝不要提交真实密钥。
#
# 说明：
# - 变量名大小写敏感，取值一律写成一行；列表型支持 JSON 数组或逗号分隔。
# - 未列出的变量说明它有内置默认值，通常不需要改。
# - 修改 env 需要重启进程才生效；LLM 一项例外，可以在管理台「模型服务」
#   逐字段热覆盖，改完立即生效（见第 5 节）。

# =====================================================================
# 1. 安全与会话
# =====================================================================

# SECURITY WARNING: keep the secret key used in production secret!
# 留空时应用启动会自动生成 256 位随机密钥并写回本文件（多进程启动只会
# 持久化同一把）。生产建议显式给定并纳入密钥管理：
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 会话 Cookie 名与 token 有效期（分钟）。默认 8 小时；需要长会话由前端
# 定期续期，而不是放长 token 生命周期。
AUTH_COOKIE_NAME=toolhub_session
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 生产（HTTPS）必须为 true；本地用 HTTP 开发时改成 false，否则浏览器不存 Cookie。
AUTH_COOKIE_SECURE=false

# 仅当部署在可信反向代理（Nginx/Traefik 等）之后时开启。开启后审计与限流
# 信任 X-Forwarded-For；直连部署时该头可被客户端伪造，必须保持 false。
TRUST_PROXY_HEADERS=false

# =====================================================================
# 2. 数据库
# =====================================================================

# 默认 SQLite（文件落在 backend/toolhub.db）。生产建议 PostgreSQL：
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg://toolhub:pw@127.0.0.1:5432/toolhub
SQLALCHEMY_DATABASE_URI=sqlite:///./toolhub.db

# =====================================================================
# 3. 任务产物与上传缓存
# =====================================================================

# 上传内容与任务产物的落盘根目录。删掉本行 = 用系统临时目录下的
# toolhub-task-artifacts。不要写成空值：空串会被 Path("") 解析成当前工作
# 目录，产物直接落进仓库。
# TASK_ARTIFACT_ROOT=/data/toolhub-artifacts

# 产物 blob 保留小时数，以及清理任务的运行间隔（小时）。
TASK_ARTIFACT_BLOB_TTL_HOURS=168
TASK_ARTIFACT_CLEANUP_INTERVAL_HOURS=6

# blob 总占用允许占所在磁盘的比例上限（0~1），超出后按 LRU 淘汰。
TASK_ARTIFACT_BLOB_MAX_DISK_RATIO=0.2

# =====================================================================
# 4. 资产核对任务
# =====================================================================

# 同时进行的核对任务数。任务本身吃内存与磁盘，多实例部署时这仍是单实例上限。
ASSET_COMPARISON_MAX_ACTIVE_JOBS=1
ASSET_COMPARISON_JOB_TTL_HOURS=24
ASSET_COMPARISON_MAX_STORED_JOBS=20
ASSET_COMPARISON_MAX_STORAGE_BYTES=1073741824

# =====================================================================
# 5. 本地大模型（全局 LLM 网关的 env 默认层）
# =====================================================================
# 这些值只是「默认层」。运行时可在管理台「系统设置 → 模型服务」逐字段覆盖，
# 覆盖层清空即回落到这里 —— 所以调参请在管理台做（立即生效、无需重启），
# 这里只放部署期就该固定的东西（地址、密钥、协议）。

# 总开关。false 时所有工具立即拿到 llm_disabled，不必改地址。
LLM_ENABLED=true

# 协议：
#   openai_compat —— llama.cpp server、vLLM、Ollama 的 /v1 兼容层
#   ollama        —— Ollama 原生 /api/chat（才能逐请求设 num_ctx / think）
LLM_PROVIDER=openai_compat

# 模型服务地址，必须以 http:// 或 https:// 开头（漏写协议会被直接拒绝，
# 不自动补全 —— 手误不该变成明文传输）。模型跑在另一台机器时改成那台
# 机器的地址，例如 http://192.168.1.20:8080/v1。
# 选 ollama 协议时不用带 /v1（带上也会被规范化掉）。
LLM_BASE_URL=http://127.0.0.1:8080/v1

# 本地服务通常留空；托管服务与 HTTPS 网关才需要。
LLM_API_KEY=

# 模型名必须与服务端 /v1/models 返回的名字完全一致。
# 注意一个坑：llama.cpp 只挂一个模型时会忽略请求里的 model 字段，于是
# 名字写错也能跑通，挂第二个模型后立刻 404。用 --alias 起别名最省事：
#     llama-server -m model.gguf --alias my-model-name
# 管理台「测试连接」会把「服务端列表里没有这个名字」显式报出来。
LLM_MODEL=ggml-org/gemma-3-4b-it-qat-GGUF:Q4_0

# 读超时（秒）。本地小模型跑满一两分钟是常态 —— 实测 0.9B 思考模型做一次
# 完整的测试时间分析要 70 秒上下，不要按「HTTP 应该很快」把它调小。
LLM_TIMEOUT_SECONDS=180
LLM_CONNECT_TIMEOUT_SECONDS=5

# 单次补全的 token 预算。思考类模型的思考内容同样吃这份预算（实测
# llama.cpp + K2-Horizon-0.9B：一句短提示词光思考就 443 token，正文只有
# 12 字）。给小了模型会先把预算用光、留下空正文。
LLM_MAX_TOKENS=1500

# 分析类结论要可复现，取低温。
LLM_TEMPERATURE=0.2

# 思考强度：high / medium / low / none / max。留空 = 不发送该字段，模型
# 保持自己的默认行为。想压低延迟与 token 消耗就设 none（正文质量换速度）。
LLM_REASONING_EFFORT=

# 上下文窗口（token）。0 = 不发送，由服务端决定。仅 ollama 协议能逐请求
# 生效；llama.cpp 需要在服务端设 --ctx-size，Ollama 设 OLLAMA_CONTEXT_LENGTH。
LLM_NUM_CTX=0

# 并发闸门。本地单卡模型的真实并发容量就是 1~2，超发只会让请求在 GPU
# 队列里排队并吃掉 FastAPI sync 端点共享的 40 个线程，把全站其它接口一起
# 拖死。默认 1 路执行 + 8 个排队位，排满立即 429 带 Retry-After。
# 有多卡 / 多副本时才调大 max_concurrency。
LLM_MAX_CONCURRENCY=1
LLM_MAX_QUEUED=8

# 重试：只重试连接失败、超时、429、5xx；4xx 配置错一次都不重试。
# 流式请求只在「第一个正文片段之前」重试，已经吐过字不重放。
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5

# 熔断：连续失败达到阈值后进入冷却，期间直接拒绝而不再压上游；
# 管理员改配置会立即解除冷却，方便当场验证新配置。
LLM_ALLOWED_FAILURES=3
LLM_COOLDOWN_SECONDS=60

# 结果缓存（进程内 TTL + LRU，不落盘）。同一份统计上下文反复点击直接命中，
# 从 70 秒降到亚毫秒。0 = 关闭缓存。缓存键含模型与生成参数，改参数即失效。
LLM_CACHE_TTL_SECONDS=900
LLM_CACHE_MAX_ENTRIES=128

# 探活结果缓存，避免状态页反复压上游。
LLM_HEALTH_CACHE_TTL_SECONDS=15

# =====================================================================
# 6. 实时推送多实例（可选 Redis）
# =====================================================================

# 设置后 realtime hub 用 Redis Pub/Sub 跨实例广播；未设置或连接失败自动
# 回落进程内 hub，单实例照常可用。
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=
# 部署级频道名。多套 ToolHub 共用同一个 Redis 时必须互不相同，否则
# user_id 重叠会让 session / permission 事件串台。
REALTIME_REDIS_CHANNEL=toolhub:realtime

# =====================================================================
# 7. 注册审批与初始管理员
# =====================================================================

# 初始管理员：仅在用户表为空且用户名/密码都已配置时，启动自动创建超级
# 管理员。只配置其中一项视为配置错误，健康检查返回 503。
# 默认值是弱口令，首次登录后立刻改密。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin

# 注册接口限流（单实例内存滑动窗口，按 IP）。多实例部署请在网关层统一限流。
REGISTRATION_RATE_LIMIT_PER_IP=10
REGISTRATION_RATE_LIMIT_WINDOW=3600

# 注册域名白名单：为空表示不限制。注册流程没有独立 email 字段，因此按
# 用户名后缀匹配（用户名必须以任一项结尾）。两种写法都支持：
#   REGISTRATION_ALLOWED_DOMAINS=["@example.com","@corp.com"]
#   REGISTRATION_ALLOWED_DOMAINS=@example.com,@corp.com
REGISTRATION_ALLOWED_DOMAINS=

# 待审批/被驳回注册用户保留天数，超期由周期任务物理删除。
REGISTRATION_PENDING_TTL_DAYS=7

# =====================================================================
# 8. 会话与通知保留
# =====================================================================

# 「在线」判定窗口（分钟）：存在未吊销且最后活跃在该窗口内的会话即在线。
SESSION_ONLINE_WINDOW_MINUTES=5
# 已吊销会话保留天数。
SESSION_REVOKED_RETENTION_DAYS=7
# 已读通知保留天数。
NOTIFICATION_RETENTION_DAYS=90
